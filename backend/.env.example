c# Server
NODE_ENV=development
PORT=5000

# Database (used starting Module 2)
DATABASE_URL="mysql://user:Rithesh@13@localhost:3306/smart_campus_attendance"

# JWT (used starting Module 3)
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (Nodemailer)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Campus Attendance <no-reply@campus.edu>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OTP Mode: 'development' returns devOtp in API response for on-screen display.
# In production, set to 'sms' once SMS gateway provider is integrated.
REGISTRATION_OTP_MODE=development
