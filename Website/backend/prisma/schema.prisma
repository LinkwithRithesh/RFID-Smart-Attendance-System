generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique(map: "name") @db.VarChar(50)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique(map: "name") @db.VarChar(100)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_ibfk_1")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_ibfk_2")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "permission_id")
  @@map("role_permissions")
}

model Department {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique(map: "name") @db.VarChar(100)
  code               String              @unique(map: "code") @db.VarChar(20)
  hodUserId          Int?                @map("hod_user_id")
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  attendanceSessions AttendanceSession[]
  courses            Course[]
  hod                User?               @relation("DepartmentHod", fields: [hodUserId], references: [id], onUpdate: NoAction, map: "fk_departments_hod")
  devices            Device[]
  hodProfiles        HodProfile[]
  timetable          Timetable[]
  users              User[]              @relation("UserDepartment")

  @@index([hodUserId], map: "fk_departments_hod")
  @@map("departments")
}

model User {
  id                   Int                   @id @default(autoincrement())
  fullName             String                @map("full_name") @db.VarChar(150)
  email                String                @unique(map: "email") @db.VarChar(150)
  passwordHash         String                @map("password_hash") @db.VarChar(255)
  roleId               Int                   @map("role_id")
  departmentId         Int?                  @map("department_id")
  phone                String?               @db.VarChar(20)
  rfidCardId           String?               @unique(map: "rfid_card_id") @map("rfid_card_id") @db.VarChar(100)
  faceEmbeddingPath    String?               @map("face_embedding_path") @db.VarChar(255)
  refreshTokenHash     String?               @map("refresh_token_hash") @db.VarChar(255)
  status               UserStatus            @default(APPROVED)
  rejectionReason      String?               @map("rejection_reason") @db.VarChar(500)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  administratorProfile AdministratorProfile?
  announcementsIssued  Announcement[]        @relation("AnnouncementIssuedBy")
  attendanceRecords    Attendance[]          @relation("AttendanceUser")
  sessionsAsFaculty    AttendanceSession[]   @relation("SessionFaculty")
  sessionsOpened       AttendanceSession[]   @relation("SessionOpenedBy")
  auditLogs            AuditLog[]
  deanProfile          DeanProfile?
  headOfDepartment     Department[]          @relation("DepartmentHod")
  documentsUploaded    DocumentFile[]        @relation("DocumentUploadedBy")
  facultyProfile       FacultyProfile?
  hodProfile           HodProfile?
  housekeepingProfile  HousekeepingProfile?
  labAssistantProfile  LabAssistantProfile?
  leaveRequests        LeaveRequest[]        @relation("LeaveRequester")
  leaveApprovals       LeaveRequest[]        @relation("LeaveApprover")
  maintenanceProfile   MaintenanceProfile?
  notifications        Notification[]
  officeStaffProfile   OfficeStaffProfile?
  securityProfile      SecurityProfile?
  studentProfile       StudentProfile?
  subjectsTaught       Subject[]             @relation("SubjectFaculty")
  timetableSlots       Timetable[]           @relation("TimetableFaculty")
  ticketsCreated       HelpDeskTicket[]      @relation("TicketCreator")
  ticketsAssigned      HelpDeskTicket[]      @relation("TicketAssignee")
  ticketMessages       TicketMessage[]
  passwordResetTokens  PasswordResetToken[]
  role                 Role                  @relation(fields: [roleId], references: [id], onUpdate: NoAction, map: "users_ibfk_1")
  department           Department?           @relation("UserDepartment", fields: [departmentId], references: [id], onUpdate: NoAction, map: "users_ibfk_2")

  @@index([departmentId, isActive], map: "idx_users_dept_active")
  @@index([roleId], map: "role_id")
  @@map("users")
}

model Course {
  id                Int              @id @default(autoincrement())
  name              String           @db.VarChar(150)
  code              String           @unique(map: "code") @db.VarChar(20)
  departmentId      Int              @map("department_id")
  durationSemesters Int              @map("duration_semesters") @db.TinyInt
  department        Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "courses_ibfk_1")
  studentProfiles   StudentProfile[]
  subjects          Subject[]
  sections          Section[]

  @@index([departmentId], map: "department_id")
  @@map("courses")
}

model Subject {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(150)
  code               String              @unique(map: "code") @db.VarChar(20)
  courseId           Int                 @map("course_id")
  semester           Int                 @db.TinyInt
  credits            Int                 @default(3) @db.TinyInt
  facultyId          Int?                @map("faculty_id")
  attendanceSessions AttendanceSession[]
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "subjects_ibfk_1")
  faculty            User?               @relation("SubjectFaculty", fields: [facultyId], references: [id], onUpdate: NoAction, map: "subjects_ibfk_2")
  timetableSlots     Timetable[]

  @@index([courseId], map: "course_id")
  @@index([facultyId], map: "faculty_id")
  @@map("subjects")
}

model StudentProfile {
  userId          Int    @id @map("user_id")
  rollNumber      String @unique(map: "roll_number") @map("roll_number") @db.VarChar(30)
  courseId        Int    @map("course_id")
  currentSemester Int     @map("current_semester") @db.TinyInt
  admissionYear   Int     @map("admission_year") @db.Year
  parentName      String? @map("parent_name") @db.VarChar(150)
  parentPhone     String? @map("parent_phone") @db.VarChar(20)
  address         String? @db.VarChar(255)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "student_profiles_ibfk_1")
  course          Course @relation(fields: [courseId], references: [id], onUpdate: NoAction, map: "student_profiles_ibfk_2")

  @@index([courseId], map: "course_id")
  @@map("student_profiles")
}

model FacultyProfile {
  userId      Int       @id @map("user_id")
  employeeId  String    @unique(map: "employee_id") @map("employee_id") @db.VarChar(30)
  designation String?   @db.VarChar(100)
  joiningDate DateTime? @map("joining_date") @db.Date
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "faculty_profiles_ibfk_1")

  @@map("faculty_profiles")
}

model HodProfile {
  userId        Int        @id @map("user_id")
  employeeId    String     @unique(map: "employee_id") @map("employee_id") @db.VarChar(30)
  departmentId  Int        @map("department_id")
  appointedDate DateTime?  @map("appointed_date") @db.Date
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "hod_profiles_ibfk_1")
  department    Department @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "hod_profiles_ibfk_2")

  @@index([departmentId], map: "department_id")
  @@map("hod_profiles")
}

model DeanProfile {
  userId        Int       @id @map("user_id")
  employeeId    String    @unique(map: "employee_id") @map("employee_id") @db.VarChar(30)
  appointedDate DateTime? @map("appointed_date") @db.Date
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dean_profiles_ibfk_1")

  @@map("dean_profiles")
}

model AdministratorProfile {
  userId     Int    @id @map("user_id")
  employeeId String @unique(map: "employee_id") @map("employee_id") @db.VarChar(30)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "administrator_profiles_ibfk_1")

  @@map("administrator_profiles")
}

model OfficeStaffProfile {
  userId       Int     @id @map("user_id")
  employeeId   String  @unique(map: "employee_id") @map("employee_id") @db.VarChar(30)
  deskLocation String? @map("desk_location") @db.VarChar(100)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "office_staff_profiles_ibfk_1")

  @@map("office_staff_profiles")
}

model LabAssistantProfile {
  userId     Int     @id @map("user_id")
  employeeId String  @unique(map: "employee_id") @map("employee_id") @db.VarChar(30)
  labName    String? @map("lab_name") @db.VarChar(100)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lab_assistant_profiles_ibfk_1")

  @@map("lab_assistant_profiles")
}

model SecurityProfile {
  userId       Int     @id @map("user_id")
  employeeId   String  @unique(map: "employee_id") @map("employee_id") @db.VarChar(30)
  shift        String? @db.VarChar(20)
  postLocation String? @map("post_location") @db.VarChar(100)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "security_profiles_ibfk_1")

  @@map("security_profiles")
}

model HousekeepingProfile {
  userId     Int     @id @map("user_id")
  employeeId String  @unique(map: "employee_id") @map("employee_id") @db.VarChar(30)
  shift      String? @db.VarChar(20)
  zone       String? @db.VarChar(100)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "housekeeping_profiles_ibfk_1")

  @@map("housekeeping_profiles")
}

model MaintenanceProfile {
  userId         Int     @id @map("user_id")
  employeeId     String  @unique(map: "employee_id") @map("employee_id") @db.VarChar(30)
  shift          String? @db.VarChar(20)
  specialization String? @db.VarChar(100)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "maintenance_profiles_ibfk_1")

  @@map("maintenance_profiles")
}

model Device {
  id              Int          @id @default(autoincrement())
  deviceCode      String       @unique(map: "device_code") @map("device_code") @db.VarChar(50)
  apiKeyHash      String       @map("api_key_hash") @db.VarChar(255)
  location        String?      @db.VarChar(150)
  departmentId    Int          @map("department_id")
  status          DeviceStatus @default(OFFLINE)
  firmwareVersion String?      @map("firmware_version") @db.VarChar(20)
  lastHeartbeatAt DateTime?    @map("last_heartbeat_at") @db.DateTime(0)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(0)
  attendances     Attendance[]
  department      Department   @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "devices_ibfk_1")

  @@index([departmentId], map: "department_id")
  @@map("devices")
}

model Timetable {
  id                 Int                 @id @default(autoincrement())
  subjectId          Int                 @map("subject_id")
  facultyId          Int                 @map("faculty_id")
  departmentId       Int                 @map("department_id")
  roomNumber         String?             @map("room_number") @db.VarChar(20)
  dayOfWeek          DayOfWeek           @map("day_of_week")
  startTime          DateTime            @map("start_time") @db.Time(0)
  endTime            DateTime            @map("end_time") @db.Time(0)
  semester           Int                 @db.TinyInt
  academicYear       String              @map("academic_year") @db.VarChar(9)
  attendanceSessions AttendanceSession[]
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "timetable_ibfk_1")
  faculty            User                @relation("TimetableFaculty", fields: [facultyId], references: [id], onUpdate: NoAction, map: "timetable_ibfk_2")
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "timetable_ibfk_3")

  @@index([facultyId], map: "faculty_id")
  @@index([departmentId, dayOfWeek], map: "idx_timetable_dept_day")
  @@index([subjectId], map: "subject_id")
  @@map("timetable")
}

model AttendanceSession {
  id           Int           @id @default(autoincrement())
  sessionType  SessionType   @map("session_type")
  timetableId  Int?          @map("timetable_id")
  subjectId    Int?          @map("subject_id")
  facultyId    Int?          @map("faculty_id")
  departmentId Int           @map("department_id")
  sessionDate  DateTime      @map("session_date") @db.Date
  startTime    DateTime      @map("start_time") @db.Time(0)
  endTime      DateTime      @map("end_time") @db.Time(0)
  status       SessionStatus @default(SCHEDULED)
  overrideType OverrideType  @default(NONE) @map("override_type")
  openedBy     Int?          @map("opened_by")
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  attendances  Attendance[]
  timetable    Timetable?    @relation(fields: [timetableId], references: [id], onUpdate: NoAction, map: "attendance_sessions_ibfk_1")
  subject      Subject?      @relation(fields: [subjectId], references: [id], onUpdate: NoAction, map: "attendance_sessions_ibfk_2")
  faculty      User?         @relation("SessionFaculty", fields: [facultyId], references: [id], onUpdate: NoAction, map: "attendance_sessions_ibfk_3")
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_sessions_ibfk_4")
  openedByUser User?         @relation("SessionOpenedBy", fields: [openedBy], references: [id], onUpdate: NoAction, map: "attendance_sessions_ibfk_5")

  @@index([departmentId, sessionDate], map: "idx_sessions_dept_date")
  @@index([departmentId, status], map: "idx_sessions_dept_status")
  @@index([departmentId, sessionType, sessionDate], map: "idx_sessions_dept_type_date")
  @@index([facultyId, sessionDate], map: "idx_sessions_faculty_date")
  @@index([openedBy], map: "opened_by")
  @@index([subjectId], map: "subject_id")
  @@index([timetableId], map: "timetable_id")
  @@map("attendance_sessions")
}

model Attendance {
  id        Int               @id @default(autoincrement())
  sessionId Int               @map("session_id")
  userId    Int               @map("user_id")
  deviceId  Int?              @map("device_id")
  method    AttendanceMethod
  status    AttendanceStatus
  markedAt  DateTime          @map("marked_at") @db.DateTime(0)
  isSynced  Boolean           @default(true) @map("is_synced")
  syncedAt  DateTime?         @map("synced_at") @db.DateTime(0)
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_ibfk_1")
  user      User              @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_ibfk_2")
  device    Device?           @relation(fields: [deviceId], references: [id], onUpdate: NoAction, map: "attendance_ibfk_3")

  @@unique([sessionId, userId], map: "uq_session_user")
  @@index([deviceId], map: "device_id")
  @@index([userId, status], map: "idx_attendance_user_status")
  @@map("attendance")
}

model Notification {
  id        Int                 @id @default(autoincrement())
  userId    Int                 @map("user_id")
  title     String              @db.VarChar(150)
  message   String              @db.Text
  channel   NotificationChannel
  type      NotificationType
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?           @map("read_at") @db.DateTime(0)
  createdAt DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_ibfk_1")

  @@index([userId, createdAt], map: "idx_notifications_user_created")
  @@map("notifications")
}

model LeaveRequest {
  id                Int         @id @default(autoincrement())
  userId            Int         @map("user_id")
  fromDate          DateTime    @map("from_date") @db.Date
  toDate            DateTime    @map("to_date") @db.Date
  category          String?     @db.VarChar(50)
  subject           String?     @db.VarChar(255)
  reason            String?     @db.VarChar(500)
  documentPath      String?     @map("document_path") @db.VarChar(255)
  status            LeaveStatus @default(PENDING)
  facultyApprovedBy Int?        @map("faculty_approved_by")
  facultyApprovedAt DateTime?   @map("faculty_approved_at") @db.DateTime(0)
  approvedBy        Int?        @map("approved_by")
  decidedAt         DateTime?   @map("decided_at") @db.DateTime(0)
  createdAt         DateTime    @default(now()) @map("created_at") @db.DateTime(0)
  user              User        @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "leave_requests_ibfk_1")
  approver          User?       @relation("LeaveApprover", fields: [approvedBy], references: [id], onUpdate: NoAction, map: "leave_requests_ibfk_2")

  @@index([approvedBy], map: "approved_by")
  @@index([userId], map: "user_id")
  @@map("leave_requests")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   Int?     @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  actor      User?    @relation(fields: [actorId], references: [id], onUpdate: NoAction, map: "audit_logs_ibfk_1")

  @@index([actorId], map: "actor_id")
  @@map("audit_logs")
}

model Announcement {
  id          Int                  @id @default(autoincrement())
  referenceNo String               @unique(map: "reference_no") @map("reference_no") @db.VarChar(50)
  title       String               @db.VarChar(200)
  message     String               @db.Text
  category    AnnouncementCategory
  priority    AnnouncementPriority @default(NORMAL)
  targetRole  String?              @default("ALL") @map("target_role") @db.VarChar(20)
  issuedById  Int?                 @map("issued_by_id")
  dateIssued  DateTime             @map("date_issued") @db.Date
  isPinned    Boolean              @default(false) @map("is_pinned")
  createdAt   DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  issuedBy    User?                @relation("AnnouncementIssuedBy", fields: [issuedById], references: [id], onUpdate: NoAction, map: "announcements_ibfk_1")

  @@index([category], map: "idx_announcements_category")
  @@index([targetRole], map: "idx_announcements_target_role")
  @@index([issuedById], map: "issued_by_id")
  @@map("announcements")
}

model DocumentFile {
  id             Int              @id @default(autoincrement())
  title          String           @db.VarChar(200)
  code           String           @unique(map: "code") @db.VarChar(50)
  category       DocumentCategory
  description    String           @db.Text
  filePath       String           @map("file_path") @db.VarChar(500)
  fileSizeBytes  Int              @map("file_size_bytes")
  downloadsCount Int              @default(0) @map("downloads_count")
  uploadedById   Int?             @map("uploaded_by_id")
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  uploadedBy     User?            @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onUpdate: NoAction, map: "documents_ibfk_1")

  @@index([category], map: "idx_documents_category")
  @@index([uploadedById], map: "uploaded_by_id")
  @@map("documents")
}

model HelpDeskTicket {
  id          Int             @id @default(autoincrement())
  ticketCode  String          @unique(map: "ticket_code") @map("ticket_code") @db.VarChar(50)
  subject     String          @db.VarChar(255)
  category    String          @db.VarChar(100)
  priority    String          @default("NORMAL") @db.VarChar(20)
  status      String          @default("OPEN") @db.VarChar(20)
  userId      Int             @map("user_id")
  assignedTo  Int?            @map("assigned_to")
  resolvedAt  DateTime?       @map("resolved_at") @db.DateTime(0)
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(0)
  user        User            @relation("TicketCreator", fields: [userId], references: [id], onDelete: Cascade)
  assignee    User?           @relation("TicketAssignee", fields: [assignedTo], references: [id])
  messages    TicketMessage[]

  @@map("helpdesk_tickets")
}

model TicketMessage {
  id        Int            @id @default(autoincrement())
  ticketId  Int            @map("ticket_id")
  senderId  Int            @map("sender_id")
  content   String         @db.Text
  createdAt DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  ticket    HelpDeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  used      Boolean  @default(false)
  attempts  Int      @default(0) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_user")
  @@index([expiresAt], map: "idx_password_reset_expires")
  @@map("password_reset_tokens")
}

model Section {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(50)
  code        String @unique(map: "section_code") @db.VarChar(20)
  courseId    Int    @map("course_id")
  semester    Int    @db.TinyInt
  maxCapacity Int    @default(60) @map("max_capacity")
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("sections")
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  DECOMMISSIONED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum SessionType {
  CLASS
  WORKER_SHIFT
  EVENT
}

enum SessionStatus {
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
}

enum OverrideType {
  NONE
  EMERGENCY
  DEAN
  ADMIN
  HOD
}

enum AttendanceMethod {
  RFID_FACE
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationType {
  ATTENDANCE_CONFIRMATION
  LOW_ATTENDANCE_ALERT
  GENERAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

