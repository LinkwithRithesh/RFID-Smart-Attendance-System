  PENDING
  FACULTY_APPROVED
  APPROVED
  REJECTED
}

enum AnnouncementCategory {
  CIRCULAR
  ALERT
  DEVICE_STATUS
  EXAM
  GENERAL
}

enum AnnouncementPriority {
  URGENT
  HIGH
  NORMAL
}

enum DocumentCategory {
  CERTIFICATE
  LEAVE
  CIRCULAR
  GUIDELINES
}

model OtpVerification {
  id          Int       @id @default(autoincrement())
  email       String    @unique @db.VarChar(150)
  otpHash     String    @map("otp_hash") @db.VarChar(255)
  payloadJson String    @map("payload_json") @db.Text
  expiresAt   DateTime  @map("expires_at") @db.DateTime(0)
  attempts    Int       @default(0) @db.TinyInt
  consumedAt  DateTime? @map("consumed_at") @db.DateTime(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@map("otp_verifications")
}

