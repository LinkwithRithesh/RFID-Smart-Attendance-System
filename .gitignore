# ================================
# SmartAttend Git Ignore
# ================================

# Node dependencies
node_modules/
**/node_modules/

# Next.js
.next/
**/.next/
out/
**/out/

# Build files
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/

# Environment / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.local.example

# Logs
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime uploads
uploads/
**/uploads/

# Cache
.cache/
**/.cache/
.turbo/
**/.turbo/

# TypeScript
*.tsbuildinfo

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp